<component type="desktop-application">
  <id>pelliper</id>
  <name>Pelliper</name>
  <summary>Privacy-first email client</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      Pelliper is a privacy-first email client built with KDE Kirigami.
      It supports IMAP/SMTP with automatic account discovery, OAuth authentication,
      and local caching for offline access.
    </p>
    <p>Features:</p>
    <ul>
      <li>IMAP/SMTP support with automatic server discovery</li>
      <li>OAuth authentication for Google, Microsoft, and other providers</li>
      <li>Local SQLite cache for offline access</li>
      <li>Privacy-first: remote content blocked by default</li>
      <li>SPF/DKIM/DMARC verification</li>
      <li>System tray integration</li>
    </ul>
  </description>
  <launchable type="desktop-id">pelliper.desktop</launchable>
  <provides>
    <binary>pelliper</binary>
  </provides>
